generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  status    String   @default("active")
  metadata  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants Tenant[]

  @@index([status])
}

model Tenant {
  id                 String   @id @default(cuid())
  organizationId     String?
  slug               String   @unique
  name               String
  businessType       String   @default("retail")
  status             String   @default("active")
  lifeosBusinessId   String?
  logoUrl            String?
  primaryColor       String   @default("#1D4ED8")
  settings           Json
  /// legacy: created before paid activation (open); pending: awaiting a verified setup payment; active: verified.
  activationStatus   String   @default("legacy")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  storeConfig  StoreConfig?
  modules      TenantModule[]
  staff        StaffMember[]
  staffSessions StaffSession[]
  categories   ProductCategory[]
  products     Product[]
  variants     ProductVariant[]
  carts        Cart[]
  orders       Order[]
  inventoryMovements InventoryMovement[]
  mediaAssets  MediaAsset[]
  businessPublications BusinessPublication[]
  auditLogs    AuditLog[]
  activations  Activation[]
  portalInstall PortalInstall?

  @@index([organizationId])
  @@index([status])
}

/// Merchant storefront config — pickup location, currency, delivery radius.
model StoreConfig {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  storeName               String
  subdomain               String   @unique
  pickupAddressLine1      String
  pickupAddressLine2      String?
  pickupCity              String
  pickupRegion            String?
  pickupPostalCode        String?
  pickupCountry           String
  pickupLat               Float
  pickupLng               Float
  defaultCurrency         String   @default("NGN")
  deliveryRadiusKm        Float    @default(15)
  platformCommissionBps   Int      @default(250)
  deliveryFeeMinor        Int      @default(150000)
  platformPayeeId         String   @default("lifeos-platform")
  riderPayeeId            String   @default("logistics-rider-pool")
  /// Offline payment methods the merchant accepts. Bank details belong to the merchant.
  payOnDeliveryEnabled    Boolean  @default(false)
  bankTransferEnabled     Boolean  @default(false)
  bankName                String?
  bankAccountName         String?
  bankAccountNumber       String?
  bankTransferNote        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  moduleId  String
  enabled   Boolean  @default(true)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
}

model StaffMember {
  id           String   @id @default(cuid())
  tenantId     String
  displayName  String
  email        String
  passwordHash String
  role         String   @default("owner")
  trustId      String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions StaffSession[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model StaffSession {
  id         String    @id @default(cuid())
  tenantId   String
  staffId    String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  sortOrder Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String?
  title       String
  description String   @default("")
  status      String   @default("active")
  images      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]

  @@index([tenantId])
  @@index([categoryId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  tenantId       String
  productId      String
  sku            String
  title          String
  barcode        String?
  priceMinor     Int
  inventoryCount Int      @default(0)
  reservedCount  Int      @default(0)
  weightGrams    Int      @default(0)
  lengthCm       Float    @default(0)
  widthCm        Float    @default(0)
  heightCm       Float    @default(0)
  images         Json
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]
  movements InventoryMovement[]

  @@unique([tenantId, sku])
  @@index([productId])
  @@index([barcode])
}

model InventoryMovement {
  id         String   @id @default(cuid())
  tenantId   String
  variantId  String
  delta      Int
  reason     String
  reference  String?
  createdAt  DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, variantId])
}

model Cart {
  id           String   @id @default(cuid())
  tenantId     String
  buyerTrustId String
  status       String   @default("open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  CartItem[]
  orders Order[]

  @@index([tenantId, buyerTrustId, status])
  @@index([tenantId])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  variantId  String
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
}

model Order {
  id                       String    @id @default(cuid())
  tenantId                 String
  cartId                   String?
  orderNumber              String
  status                   String    @default("PENDING_PAYMENT")
  buyerTrustId             String
  buyerName                String
  buyerPhone               String?
  buyerEmail               String?
  shippingAddressLine1     String
  shippingAddressLine2     String?
  shippingCity             String
  shippingRegion           String?
  shippingPostalCode       String?
  shippingCountry          String
  shippingLat              Float
  shippingLng              Float
  currency                 String
  merchandiseMinor         Int
  deliveryFeeMinor         Int
  platformCommissionMinor  Int
  merchantShareMinor       Int
  riderFeeMinor            Int
  totalMinor               Int
  escrowPaymentId          String?
  logisticsJobId           String?
  invoiceDriveKey          String?
  invoiceDriveUrl          String?
  paymentExpiresAt         DateTime
  paidAt                   DateTime?
  dispatchedAt             DateTime?
  deliveredAt              DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  cancelReason             String?
  /// pay_on_delivery | bank_transfer; null for orders from the disabled online checkout.
  paymentMethod            String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart   Cart?        @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items  OrderItem[]
  events OrderEvent[]
  payment OrderPayment?

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([buyerTrustId])
  @@index([logisticsJobId])
  @@index([escrowPaymentId])
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  variantId     String
  sku           String
  title         String
  quantity      Int
  unitPriceMinor Int
  weightGrams   Int    @default(0)
  lengthCm      Float  @default(0)
  widthCm       Float  @default(0)
  heightCm      Float  @default(0)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  fromStatus String?
  toStatus  String
  source    String
  payload   Json
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model MediaAsset {
  id          String   @id @default(cuid())
  tenantId    String
  namespace   String
  driveKey    String
  contentType String?
  sizeBytes   Int?
  url         String
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Merchant photo/video/post publications surfaced on LifeOS public feed and storefront.
model BusinessPublication {
  id               String    @id @default(cuid())
  tenantId         String
  type             String
  title            String    @default("")
  caption          String    @default("")
  status           String    @default("draft")
  audience         String    @default("public")
  relatedProductId String?
  mediaAssetIds    Json
  publishedAt      DateTime?
  scheduledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status, audience, publishedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorKind  String
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([action])
}

/// A store's paid brand setup, verified by hand by Digiconomy platform staff. No payment is
/// collected here: the owner pays outside the platform and submits the transfer reference.
model Activation {
  id                 String    @id @default(cuid())
  tenantId           String
  plan               String
  amountMinor        Int
  currency           String
  status             String    @default("payment_submitted")
  partnerId          String?
  paymentReference   String
  payerName          String
  paidAt             DateTime?
  submittedById      String?
  tenantStatusBefore String
  /// The normalized payment reference while it is claimed (submitted, verified or reversed): one payment activates one store.
  referenceKey       String?   @unique
  /// The tenant id while this submission awaits review: one open submission per store.
  pendingKey         String?   @unique
  /// The tenant id while verified: at most one verified activation per store.
  activeKey          String?   @unique
  verifiedById       String?
  verifiedAt         DateTime?
  /// Set once verification has opened the store and credited any commission; reversal waits for it.
  appliedAt          DateTime?
  rejectedById       String?
  rejectedAt         DateTime?
  rejectedReason     String?
  reversedById       String?
  reversedAt         DateTime?
  reversedReason     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  partner    MarketingPartner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  commission PartnerCommission?
  documents  BillingDocument[]

  @@index([tenantId])
  @@index([status])
}

/// A marketing partner who refers businesses; earns commission on verified setup payments only.
model MarketingPartner {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  email       String
  status      String   @default("active")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activations Activation[]
  commissions PartnerCommission[]

  @@index([status])
}

/// Commission on one verified setup activation, credited at most once and reversed with it.
model PartnerCommission {
  id           String    @id @default(cuid())
  activationId String    @unique
  partnerId    String
  rateBps      Int
  amountMinor  Int
  currency     String
  status       String    @default("accrued")
  reversedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activation Activation       @relation(fields: [activationId], references: [id], onDelete: Restrict)
  partner    MarketingPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([partnerId, status])
}

/// Digiconomy staff who verify setup payments and manage partners. Not store accounts.
model PlatformOperator {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  role         String   @default("verifier")
  /// TOTP secret, encrypted with ECO_OPERATOR_MFA_KEY; set when enrollment starts.
  mfaSecretEnc String?
  mfaEnabledAt DateTime?
  /// Last accepted TOTP time step: a code is never accepted twice.
  mfaLastStep  Int?
  createdById  String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions PlatformSession[]
}

model PlatformSession {
  id         String    @id @default(cuid())
  operatorId String
  tokenHash  String    @unique
  /// full: an MFA-verified session; mfa_challenge / mfa_enrollment: short-lived, MFA routes only.
  kind       String    @default("full")
  lastSeenAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  operator PlatformOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

/// Payment for an order paid outside the platform: bank transfer to the merchant, or cash on
/// delivery. Only a store owner or admin moves it to verified or collected; a customer's
/// notification never does. No money passes through Digiconomy.
model OrderPayment {
  id                  String    @id @default(cuid())
  orderId             String    @unique
  tenantId            String
  method              String
  status              String
  amountMinor         Int
  currency            String
  /// Bank details shown to the customer when the order was placed, kept as they were then.
  bankName            String?
  bankAccountName     String?
  bankAccountNumber   String?
  customerReference   String?
  customerPayerName   String?
  customerReportedAt  DateTime?
  verifiedById        String?
  verifiedAt          DateTime?
  verifiedAmountMinor Int?
  merchantReference   String?
  rejectedById        String?
  rejectedAt          DateTime?
  rejectedReason      String?
  refundReference     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
}

/// Draft invoice or receipt for a store's setup fee. Tax fields stay unreviewed until a tax
/// treatment is decided; nothing here is a final tax document.
model BillingDocument {
  id                   String    @id @default(cuid())
  activationId         String
  tenantId             String
  kind                 String
  number               String    @unique
  status               String    @default("draft")
  billedToName         String
  amountMinor          Int
  currency             String
  transactionReference String?
  taxTreatment         String    @default("unreviewed")
  taxRateBps           Int?
  taxAmountMinor       Int?
  supplierTaxId        String?
  customerTaxId        String?
  issuedAt             DateTime  @default(now())
  voidedAt             DateTime?
  voidReason           String?

  activation Activation @relation(fields: [activationId], references: [id], onDelete: Restrict)

  @@unique([activationId, kind])
  @@index([tenantId])
}

/// One-time invitation for a new platform operator, issued by a platform admin.
model PlatformInvitation {
  id          String    @id @default(cuid())
  email       String
  role        String
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

/// A high-risk platform action that a second admin must approve before it runs.
model PlatformApproval {
  id            String    @id @default(cuid())
  kind          String
  targetId      String
  reason        String
  status        String    @default("pending")
  /// "<kind>:<targetId>" while pending: one open request per action and target.
  pendingKey    String?   @unique
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

/// Single-use record of every accepted service-token jti: hex SHA-256 of iss + "\n" + jti only.
/// The LifeOS Portal install a store was created for (one store per install), with the provisioning
/// request's Idempotency-Key ("portal-install:<id>") and fingerprint. A table of its own: adding unique
/// columns to Tenant makes the boot-time `db push` refuse on a database that already has stores.
model PortalInstall {
  installId    String   @id
  tenantId     String   @unique
  provisionKey String?  @unique
  requestHash  String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ServiceTokenUse {
  digest    String   @id
  issuer    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Registration of a marketplace-created seller store with LifeOS Portal, sent with a signed
/// service token. The exact body is kept so a retry or backfill resends identical bytes.
model PortalSellerRegistration {
  applicationId       String    @id
  sellerTenantId      String
  marketplaceTenantId String
  body                String
  status              String    @default("pending")
  httpStatus          Int?
  attempts            Int       @default(0)
  lastError           String?
  lastAttemptAt       DateTime?
  registeredAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
}
