generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  status    String   @default("active")
  metadata  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants Tenant[]

  @@index([status])
}

model Tenant {
  id                 String   @id @default(cuid())
  organizationId     String?
  slug               String   @unique
  name               String
  businessType       String   @default("retail")
  status             String   @default("active")
  lifeosBusinessId   String?
  logoUrl            String?
  primaryColor       String   @default("#1D4ED8")
  settings           Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  storeConfig  StoreConfig?
  modules      TenantModule[]
  staff        StaffMember[]
  staffSessions StaffSession[]
  categories   ProductCategory[]
  products     Product[]
  variants     ProductVariant[]
  carts        Cart[]
  orders       Order[]
  inventoryMovements InventoryMovement[]
  mediaAssets  MediaAsset[]
  auditLogs    AuditLog[]

  @@index([organizationId])
  @@index([status])
}

/// Merchant storefront config — pickup location, currency, delivery radius.
model StoreConfig {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  storeName               String
  subdomain               String   @unique
  pickupAddressLine1      String
  pickupAddressLine2      String?
  pickupCity              String
  pickupRegion            String?
  pickupPostalCode        String?
  pickupCountry           String
  pickupLat               Float
  pickupLng               Float
  defaultCurrency         String   @default("NGN")
  deliveryRadiusKm        Float    @default(15)
  platformCommissionBps   Int      @default(250)
  deliveryFeeMinor        Int      @default(150000)
  platformPayeeId         String   @default("lifeos-platform")
  riderPayeeId            String   @default("logistics-rider-pool")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  moduleId  String
  enabled   Boolean  @default(true)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
}

model StaffMember {
  id           String   @id @default(cuid())
  tenantId     String
  displayName  String
  email        String
  passwordHash String
  role         String   @default("owner")
  trustId      String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions StaffSession[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model StaffSession {
  id         String    @id @default(cuid())
  tenantId   String
  staffId    String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  sortOrder Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String?
  title       String
  description String   @default("")
  status      String   @default("active")
  images      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]

  @@index([tenantId])
  @@index([categoryId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  tenantId       String
  productId      String
  sku            String
  title          String
  barcode        String?
  priceMinor     Int
  inventoryCount Int      @default(0)
  reservedCount  Int      @default(0)
  weightGrams    Int      @default(0)
  lengthCm       Float    @default(0)
  widthCm        Float    @default(0)
  heightCm       Float    @default(0)
  images         Json
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]
  movements InventoryMovement[]

  @@unique([tenantId, sku])
  @@index([productId])
  @@index([barcode])
}

model InventoryMovement {
  id         String   @id @default(cuid())
  tenantId   String
  variantId  String
  delta      Int
  reason     String
  reference  String?
  createdAt  DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, variantId])
}

model Cart {
  id           String   @id @default(cuid())
  tenantId     String
  buyerTrustId String
  status       String   @default("open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  CartItem[]
  orders Order[]

  @@index([tenantId, buyerTrustId, status])
  @@index([tenantId])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  variantId  String
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
}

model Order {
  id                       String    @id @default(cuid())
  tenantId                 String
  cartId                   String?
  orderNumber              String
  status                   String    @default("PENDING_PAYMENT")
  buyerTrustId             String
  buyerName                String
  buyerPhone               String?
  buyerEmail               String?
  shippingAddressLine1     String
  shippingAddressLine2     String?
  shippingCity             String
  shippingRegion           String?
  shippingPostalCode       String?
  shippingCountry          String
  shippingLat              Float
  shippingLng              Float
  currency                 String
  merchandiseMinor         Int
  deliveryFeeMinor         Int
  platformCommissionMinor  Int
  merchantShareMinor       Int
  riderFeeMinor            Int
  totalMinor               Int
  escrowPaymentId          String?
  logisticsJobId           String?
  invoiceDriveKey          String?
  invoiceDriveUrl          String?
  paymentExpiresAt         DateTime
  paidAt                   DateTime?
  dispatchedAt             DateTime?
  deliveredAt              DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  cancelReason             String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart   Cart?        @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items  OrderItem[]
  events OrderEvent[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([buyerTrustId])
  @@index([logisticsJobId])
  @@index([escrowPaymentId])
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  variantId     String
  sku           String
  title         String
  quantity      Int
  unitPriceMinor Int
  weightGrams   Int    @default(0)
  lengthCm      Float  @default(0)
  widthCm       Float  @default(0)
  heightCm      Float  @default(0)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  fromStatus String?
  toStatus  String
  source    String
  payload   Json
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model MediaAsset {
  id          String   @id @default(cuid())
  tenantId    String
  namespace   String
  driveKey    String
  contentType String?
  sizeBytes   Int?
  url         String
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorKind  String
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([action])
}
