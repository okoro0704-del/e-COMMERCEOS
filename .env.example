NODE_ENV=development
ECO_PORT=8900
DATABASE_URL=file:./dev.db
SESSION_SECRET=dev-only-session-secret-change-me
WEBHOOK_SECRET=dev-only-webhook-secret
PRIMITIVES_MODE=local
TRUSTID_API_URL=http://localhost:8791
ELFCOM_URL=http://localhost:4000
SOVEREIGN_DRIVE_URL=http://localhost:4100
PLATFORM_JOBS_URL=http://localhost:3000
MASTER_DISTRIBUTOR_URL=http://localhost:3100
FUNDZMAN_URL=http://localhost:4200
LOGISTICS_OS_URL=http://localhost:4300
PRIMITIVES_SERVICE_TOKEN=dev-primitives-token
INTERNAL_PROVISION_TOKEN=dev-primitives-token
STOREFRONT_LAUNCH_URL=https://{subdomain}.getlifeos.app
ADMIN_LAUNCH_URL=https://{subdomain}.getlifeos.app/admin
PORTAL_API_URL=
PORTAL_INTERNAL_TOKEN=
# Exact origins, or https://*.<domain you control> for per-store subdomains. Production refuses *, http and shared-hosting wildcards.
CORS_ORIGINS=http://localhost:5190,http://localhost:5191
UNPAID_ORDER_TIMEOUT_MS=1800000
# Paid brand setup (manual payment verification). Off unless set.
ECO_ACTIVATION_REQUIRED=false
ECO_SETUP_PAYMENT_INSTRUCTIONS=
ECO_EARLY_ADOPTER_ENABLED=false
# Creates platform operators; at least 32 characters and never the Portal service token. Empty disables it.
ECO_PLATFORM_ADMIN_TOKEN=
